import pandas as pd
import numpy as np

df = pd.read_csv("student_database.csv")

print("Original Data:")
print(df)

df = df[(df["Marks"] > 85) & (df["Age"] > 20)]

print("\nFiltered Data:")
print(df)

df = df.sort_values(by=["Marks", "Age"], ascending=[False, True])

print("\nSorted Data:")
print(df)

df.loc[df["Marks"] > 90, "Grade"] = "Excellent"
df.loc[(df["Marks"] > 85) & (df["Marks"] <= 90), "Grade"] = "Very Good"

print("\nData after Value Assignment:")
print(df)

marks = np.array(df["Marks"].values)

print("\nNumPy Marks Array:")
print(marks)

print("\nIndexing:")
print("First student's marks:", marks[0])
print("Second student's marks:", marks[1])

print("\nSlicing:")
print("First three students:", marks[:3])
print("Marks from index 1 to 3:", marks[1:4])

print("\nReshaping:")
if len(marks) >= 4:
    reshaped_marks = marks[:4].reshape(2, 2)
    print(reshaped_marks)

print("\nVectorized Operations:")

new_marks = marks + 5
print("Marks after adding 5:")
print(new_marks)

double_marks = marks * 2
print("\nMarks multiplied by 2:")
print(double_marks)

percentage = marks / 100 * 100
print("\nPercentage:")
print(percentage)

print("\nNumerical Computations:")

print("Total Marks:", np.sum(marks))
print("Average Marks:", np.mean(marks))
print("Highest Marks:", np.max(marks))
print("Lowest Marks:", np.min(marks))

df.to_csv("student_database.csv", index=False)
